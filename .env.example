# Скопируй в .env на сервере и подставь свои значения.
# .env НИКОГДА не коммитится в git.

# Сгенерировать новый ключ:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=ЗАМЕНИ_МЕНЯ

DJANGO_DEBUG=False

# Домен сайта без схемы, через запятую
DJANGO_ALLOWED_HOSTS=gamesite.duckdns.org

# Полный URL со схемой
DJANGO_CSRF_TRUSTED_ORIGINS=https://gamesite.duckdns.org

# CORS нужен, только если фронт живёт на ОТДЕЛЬНОМ домене
# (например, вынесен на Cloudflare Pages). При схеме "всё на одном сервере"
# строку можно не трогать.
#DJANGO_CORS_ALLOWED_ORIGINS=https://gamesite.pages.dev

DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (опционально) ---
# Раскомментируй, чтобы переехать с SQLite. Без POSTGRES_DB используется SQLite.
#POSTGRES_DB=gamesite
#POSTGRES_USER=gamesite
#POSTGRES_PASSWORD=
#POSTGRES_HOST=127.0.0.1
#POSTGRES_PORT=5432
